{
  "name": "career-forge",
  "version": "1.0.0",
  "description": "Local AI-powered multi-stream career growth, learning, practice & gamified progression platform with TypeSafe Jev routing",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/server/__tests__/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.79.0",
    "mammoth": "^1.13.0",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
